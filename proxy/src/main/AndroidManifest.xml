<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The bridge provider requires the signature-level `dev.understudy.permission.BRIDGE`, but this
      APK deliberately does NOT define it — the Understudy app does.

      A `signature` permission is granted only to packages signed like whichever package defines
      it. This APK is signed with a per-install key generated on the device (SigningIdentity), so
      if it defined BRIDGE, only packages sharing that throwaway key could hold it — and the
      Understudy app, signed with its own build-time key, never could. The platform enforces a
      provider's android:permission BEFORE any of the provider's code runs, so the app would be
      refused at the gate and ProxyFileBridge.enforceCaller()'s generator-certificate digest check
      would never execute. Letting the app define BRIDGE (tied to the app's certificate, which the
      app matches) opens the gate for the legitimate caller, and the digest the generator baked
      into this APK's assets is what actually pins it to the exact install that made it.

      Requiring a permission defined by another package is ordinary Android; the platform resolves
      it device-wide by name. The app is always installed before the proxy it generates, so the
      definition is present by the time this provider is reached.
    -->
    <application
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:label="Understudy Proxy"
        android:supportsRtl="false">

        <!--
          The whole mechanism: this process *is* the target package for this user, so the
          FUSE layer hands it unrestricted read/write access to its own
          /Android/data/<pkg> and /Android/obb/<pkg>. It then re-exports that tree to
          Understudy over Binder.

          Authority is the bare package name so that retargeting the manifest's package
          attribute also retargets the authority — one string-pool substitution.
        -->
        <provider
            android:name=".bridge.ProxyFileBridge"
            android:authorities="${applicationId}"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="dev.understudy.permission.BRIDGE" />

        <!--
          Only exists so the user can see something is installed, and so we can be
          disabled to hide the proxy from the launcher without uninstalling it.
        -->
        <activity
            android:name=".ProxyStatusActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.DarkActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
