<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the real theming; this is only the pre-composition window background so
      there is no white flash on cold start. Edge-to-edge is handled in code.
    -->
    <style name="Theme.Understudy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
