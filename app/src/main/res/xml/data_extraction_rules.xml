<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12+.

  Everything is excluded, and the exclusions are the point rather than a formality. Two things
  live in this app's private storage that must never leave the device:

    * signing/proxy-signer.pk8 and signing/proxy-signer.x509.pem — the identity that signs every
      generated proxy. Restoring it onto another device would let that device impersonate this
      one's proxies, and restoring it *over* an existing identity would break every proxy already
      installed here (they would no longer share a signer, so the bridge permission dies).
    * generated-proxies/*.apk — regenerable, and useless without the key anyway.

  `allowBackup="false"` already says this for Android 11 and below; from 12 on the platform reads
  this file instead, so declaring only one of the two would leave a hole on the other half of the
  supported range.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
