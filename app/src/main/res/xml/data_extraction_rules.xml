<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12+.

  Everything is excluded, and the exclusions are the point rather than a formality. Two things
  live in this app's private storage that must never leave the device:

    * signing/proxy-signer.pk8 and signing/proxy-signer.x509.pem — the identity that signs every
      generated proxy. Restoring it onto another device would let that device impersonate this
      one's proxies. Restoring it *over* an existing identity is worse and less obvious: package
      identity is device-wide, so a proxy already installed here was signed by the OLD key, and a
      regenerated one signed by the restored key can no longer update it in place. Reinstalling
      means a full uninstall first, which destroys the very Android/data/<pkg> this app exists to
      protect. (The bridge permission is not what breaks — :app defines it, and the caller check
      uses the app's own certificate, neither of which depends on this key.)
    * generated-proxies/*.apk — regenerable, and useless without the key anyway.

  `allowBackup="false"` already says this for Android 11 and below; from 12 on the platform reads
  this file instead, so declaring only one of the two would leave a hole on the other half of the
  supported range.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
