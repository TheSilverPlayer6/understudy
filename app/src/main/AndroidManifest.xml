<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Needed to stage the generated proxy APK through PackageInstaller. This is a PER-USER
      appop: it must be granted separately inside each secondary profile, from that
      profile's own Settings. The app detects the missing grant and deep-links the user
      there rather than failing with an opaque installer error.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Needed to launch the system uninstall dialog for the proxy. This is the *request* flavour,
      not DELETE_PACKAGES (which is signature|privileged and unobtainable): it shows the user the
      confirmation dialog and nothing happens without them.

      It matters more than a normal uninstall because the proxy declares
      `hasFragileUserData="true"`, which makes THIS dialog the only unprivileged place where
      "Keep app data" is offered — the one route to a data-preserving uninstall with no shell.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      The bridge permission THIS APP defines, at signature level.

      Why the app defines it and not the proxy — this is load-bearing and was gotten wrong once:
      a `signature` permission is granted only to packages signed like whichever package DEFINES
      it. In production the proxy is signed with a per-install key (SigningIdentity) that can
      never match this app's build-time key, because the app does not have its own release private
      key on the device. So if the proxy defined BRIDGE, this app could not hold it, and the
      platform would refuse every bridge call at the provider's android:permission gate — before
      ProxyFileBridge.enforceCaller()'s generator-certificate digest check ever ran. The digest
      fix would be dead code and a signed release would be unable to talk to the proxy it made.

      Defining it here ties the permission to THIS app's certificate, which the caller (this app)
      trivially matches, so the platform gate opens and the digest check becomes the real pin: it
      restricts the caller to the exact install that generated the proxy, not merely "some app
      signed with the release key". The proxy only *requires* BRIDGE on its provider; requiring a
      permission defined by another package is ordinary Android.

      Easy to forget and invisible in unit tests: Robolectric does not enforce permissions, so the
      bridge works fine on the JVM without this and then fails with SecurityException on every real
      device. Caught by the instrumented CI runs (BridgePremiseTest, CallerAuthPremiseTest).
    -->
    <permission
        android:name="dev.understudy.permission.BRIDGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.understudy.permission.BRIDGE" />

    <!--
      Deliberately NOT requested:
        * QUERY_ALL_PACKAGES — Play-restricted and unnecessary. We never enumerate packages;
          we detect the proxy by calling its provider, which doubles as proof that it works.
        * MANAGE_EXTERNAL_STORAGE — useless here by design. Since Android 11 the FUSE layer
          hides other apps' Android/data even from "All files access" holders, which is the
          whole reason this app exists.
    -->

    <application
        android:name=".UnderstudyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Understudy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Understudy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receives PackageInstaller session results. Not exported: the PendingIntent we hand
          to the system installer carries our own identity back to us.
        -->
        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false" />
    </application>

</manifest>
